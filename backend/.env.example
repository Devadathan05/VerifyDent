# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is gitignored — never commit real credentials.

# PostgreSQL-ready: default to SQLite for zero-setup local dev.
# Point this at Postgres when you have one running, e.g.:
#   postgresql+psycopg://user:password@localhost:5432/verifydent
DATABASE_URL=sqlite:///./verifydent.db

APP_ENV=development
DEBUG=true

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Real OCR provider. On Windows, install Tesseract and set this to its executable.
# Typical path: C:\Program Files\Tesseract-OCR\tesseract.exe
EXTRACTION_PROVIDER=ocr
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe